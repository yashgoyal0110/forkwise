# Copy to .env and fill in. Values here are safe placeholders.

NODE_ENV=development
PORT=4000

# --- Database ---
# Local/dev (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) - also set provider = "postgresql" in prisma/schema.prisma:
# DATABASE_URL="postgresql://forkwise:forkwise@localhost:5432/forkwise?schema=public"

# --- Auth ---
# Use a long random string in production, e.g. `openssl rand -base64 32`
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=7d

# --- CORS ---
# "*" for local dev; a comma-separated allowlist in production.
CORS_ORIGIN=*

# --- AI (Gemini) ---
# Enables /ai/analyze-meal and /ai/parse-meal. Get a key from Google AI Studio.
# Leave unset to run without AI (those routes return 503).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
